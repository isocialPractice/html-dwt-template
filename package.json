{
    "name": "html-dwt-template",
    "displayName": "HTML DWT Template",
    "description": "HTML templates for VS Code that follow the Adobe Dreamweaver templating system.",
    "publisher": "isocialPractice",
    "author": "John Haugabook",
    "version": "1.0.0-alpha.0.1.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/isocialPractice/html-dwt-template.git"
    },
    "icon": "support/icon.png",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "adobe",
        "content",
        "dreamweaver",
        "dwt",
        "editable",
        "extension",
        "htm",
        "html",
        "php",
        "region",
        "repeatable",
        "site",
        "template",
        "templating",
        "vscode",
        "vscode-extension",
        "web",
        "website"
    ],
    "activationEvents": [
        "*"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "htmlDwtTemplate.showEditableRegions",
                "title": "Show Editable Regions",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.syncTemplate",
                "title": "Update Files Based on Template",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.updateAllFilesUsingTemplate",
                "title": "UPDATE ALL FILES USING TEMPLATE",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.toggleTemplateSync",
                "title": "Toggle Template Synchronization",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.toggleBackup",
                "title": "Toggle Backup",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.findInstances",
                "title": "Find Template Instances",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.restoreBackup",
                "title": "Restore Last HTML Backup",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.insertRepeatEntryAfter",
                "title": "Insert Entry After Selection",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.insertRepeatEntryBefore",
                "title": "Insert Entry Before Selection",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.turnOffProtection",
                "title": "Turn Off Protection",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.turnOnProtection",
                "title": "Turn On Protection",
                "category": "html-dwt-template"
            },
            {
                "command": "htmlDwtTemplate.createPageFromTemplate",
                "title": "Create New Page from Template",
                "category": "html-dwt-template"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "resourceExtname =~ /\\.(html|htm|php|asp|csp)$/",
                    "command": "htmlDwtTemplate.showEditableRegions",
                    "group": "htmlDwtTemplate"
                },
                {
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php)$/ && resourceDirname =~ /[\\\\\\/]Templates([\\\\\\/]|$)/",
                    "command": "htmlDwtTemplate.syncTemplate",
                    "group": "htmlDwtTemplate"
                },
                {
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php)$/ && resourceDirname =~ /[\\\\\\/]Templates([\\\\\\/]|$)/",
                    "command": "htmlDwtTemplate.updateAllFilesUsingTemplate",
                    "group": "htmlDwtTemplate@9"
                },
                {
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php)$/ && resourceDirname =~ /[\\\\\\/]Templates([\\\\\\/]|$)/",
                    "command": "htmlDwtTemplate.findInstances",
                    "group": "htmlDwtTemplate"
                },
                {
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php)$/ && resourceDirname =~ /[\\\\\\/]Templates([\\\\\\/]|$)/",
                    "command": "htmlDwtTemplate.createPageFromTemplate",
                    "group": "htmlDwtTemplate"
                },
                {
                    "command": "htmlDwtTemplate.restoreBackup",
                    "group": "htmlDwtTemplate"
                },
                {
                    "when": "resourceExtname =~ /\\.(html|htm|php|asp|csp)$/",
                    "command": "htmlDwtTemplate.insertRepeatEntryAfter",
                    "group": "htmlDwtTemplate@1"
                },
                {
                    "when": "resourceExtname =~ /\\.(html|htm|php|asp|csp)$/",
                    "command": "htmlDwtTemplate.insertRepeatEntryBefore",
                    "group": "htmlDwtTemplate@2"
                },
                {
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php|asp|csp)$/",
                    "command": "htmlDwtTemplate.turnOffProtection",
                    "group": "htmlDwtTemplate@3"
                },
                {
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php|asp|csp)$/",
                    "command": "htmlDwtTemplate.turnOnProtection",
                    "group": "htmlDwtTemplate@3"
                }
            ],
            "commandPalette": [
                {
                    "command": "htmlDwtTemplate.showEditableRegions",
                    "when": "resourceExtname =~ /\\.(html|htm|php|asp|csp)$/"
                },
                {
                    "command": "htmlDwtTemplate.syncTemplate",
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php)$/ && resourceDirname =~ /[\\\\\\/]Templates([\\\\\\/]|$)/"
                },
                {
                    "command": "htmlDwtTemplate.updateAllFilesUsingTemplate",
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php)$/ && resourceDirname =~ /[\\\\\\/]Templates([\\\\\\/]|$)/"
                },
                {
                    "command": "htmlDwtTemplate.toggleTemplateSync"
                },
                {
                    "command": "htmlDwtTemplate.toggleBackup"
                },
                {
                    "command": "htmlDwtTemplate.findInstances",
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php)$/ && resourceDirname =~ /[\\\\\\/]Templates([\\\\\\/]|$)/"
                },
                {
                    "command": "htmlDwtTemplate.restoreBackup"
                },
                {
                    "command": "htmlDwtTemplate.insertRepeatEntryAfter",
                    "when": "resourceExtname =~ /\\.(html|htm|php|asp|csp)$/"
                },
                {
                    "command": "htmlDwtTemplate.insertRepeatEntryBefore",
                    "when": "resourceExtname =~ /\\.(html|htm|php|asp|csp)$/"
                },
                {
                    "command": "htmlDwtTemplate.createPageFromTemplate",
                    "when": "resourceExtname =~ /\\.(dwt|html|htm|php)$/ && resourceDirname =~ /[\\\\\\/]Templates([\\\\\\/]|$)/"
                }
            ]
        },
        "configuration": {
            "title": "HTML DWT Template",
            "properties": {
                "htmlDwtTemplate.useStickyDiffPanel": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use a persistent movable panel for diff controls after 'Show Diff'. When disabled, use the standard modal popup."
                },
                "htmlDwtTemplate.enableProtection": {
                    "type": "boolean",
                    "default": true,
                    "description": "Protect the non-editable regions of pages and child templates that are based on a template."
                },
                "htmlDwtTemplate.showWarnings": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show warning messages when trying to edit protected regions"
                },
                "htmlDwtTemplate.highlightEditableRegions": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight editable regions with a green border"
                },
                "htmlDwtTemplate.highlightProtectedRegions": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight protected regions with a red background"
                },
                "htmlDwtTemplate.highlightOptionalRegions": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight optional regions with a dashed orange border"
                },
                "htmlDwtTemplate.enableTemplateSync": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "When on, saving a template updates every file based on it that is open in an editor, child templates included. Files that are not open are updated only by **Update Files Based on Template**. Open files are updated without prompts and without backups; a file with unsaved changes stays unsaved. The **html-dwt-template: Toggle Template Synchronization** command switches this setting."
                },
                "htmlDwtTemplate.confirmBeforeApply": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ask for confirmation (with optional diff preview) before writing instance changes"
                },
                "htmlDwtTemplate.enableBackup": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Back up every file that **Update Files Based on Template** is about to change, under `.html-dwt-template-backups/` in the site root. Turn off to update without backups, like the command-line tool's `--no-backup` option. The **html-dwt-template: Toggle Backup** command switches this setting."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run clean && npm run compile",
        "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
        "pre:publish": "npm run compile && vsce package",
        "compile": "tsc -p ./",
        "install:engine": "scripts\\install-engine.cmd",
        "watch": "tsc -watch -p ./",
        "test:dw": "node scripts/test-harness.js",
        "test:guided": "node scripts/guided-walkthrough.js",
        "test:diff": "node scripts/smart-diff-checker.js"
    },
    "devDependencies": {
        "@types/node": "^16.x",
        "@types/vscode": "^1.74.0",
        "typescript": "^4.9.4"
    },
    "dependencies": {
        "@isocialpractice/html-dwt-cmd-template": "^1.0.0",
        "diff": "^8.0.2"
    }
}
